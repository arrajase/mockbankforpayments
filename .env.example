DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Origins allowed to make cookie-authenticated POST/PUT calls (comma-separated).
# Leave empty to accept only the request's own host.
ALLOWED_ORIGINS=https://mockbankforpayments.onrender.com

# Set to false only for plain-http local development.
COOKIE_SECURE=true

# Failure triggers keyed on amount paise (..13 slow, ..14 500 after commit, ..15 503, ..16 collect expires).
SANDBOX_TRIGGERS=false

# Test suite only: a disposable Postgres database that will be wiped.
# TEST_DATABASE_URL=postgresql+psycopg://mockbank:mockbank@localhost:5433/mockbank_test
